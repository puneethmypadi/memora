# Dockerfile.build
FROM debian:bullseye

RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    unzip \
    zip \
    openjdk-11-jdk \
    python3 \
    python3-pip \
    git

# Install Bazelisk (Bazel wrapper)
RUN curl -L https://github.com/bazelbuild/bazelisk/releases/download/v1.18.0/bazelisk-linux-arm64 -o /usr/local/bin/bazel \
    && chmod +x /usr/local/bin/bazel

WORKDIR /app
COPY . .

CMD ["bazel", "build", "//main:memora"]